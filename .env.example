# Copy to .env to choose the model provider: an Anthropic API key
# (ANTHROPIC_API_KEY) or any Anthropic-compatible endpoint below.
# Loaded only by this daemon; your global Claude Code settings are untouched.

# DeepSeek (https://api-docs.deepseek.com/quick_start/agent_integrations/claude_code/)
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=sk-your-deepseek-key
ANTHROPIC_MODEL=deepseek-flash[1m]
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-flash[1m]
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-flash[1m]
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-flash
CLAUDE_CODE_SUBAGENT_MODEL=deepseek-flash

# Other Anthropic-compatible endpoints (mainland China sites). Set
# ANTHROPIC_AUTH_TOKEN plus the ANTHROPIC_*_MODEL ids from each provider's docs.
# Kimi (Moonshot):      ANTHROPIC_BASE_URL=https://api.moonshot.cn/anthropic
# GLM (Zhipu):          ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
# Qwen (DashScope):     ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic
#                       models (tool use verified): qwen3.7-max / qwen3.7-plus / qwen3.7-flash
# MiniMax:              ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
