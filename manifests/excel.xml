<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="TaskPaneApp">

  <Id>0d77363a-9bff-4441-8304-56502d607d86</Id>
  <Version>0.2.0.0</Version>
  <ProviderName>Excel Assistant</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Excel Assistant" />
  <Description DefaultValue="A local AI agent in the Excel side panel: reads and edits the open workbook with your choice of model." />
  <IconUrl DefaultValue="http://127.0.0.1:47834/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="http://127.0.0.1:47834/icon-64.png" />
  <SupportUrl DefaultValue="http://127.0.0.1:47834/" />

  <AppDomains>
    <AppDomain>http://127.0.0.1:47834</AppDomain>
  </AppDomains>

  <!--
    Minimum Excel API version. Required for getUsedRangeOrNullObject and
    the *OrNullObject helpers. The onSelectionChanged event (1.7+) is
    wired up inside a try/.catch in taskpane.js, so its absence
    degrades selection-tracking gracefully — no need to require 1.7.
  -->
  <Requirements>
    <Sets DefaultMinVersion="1.4">
      <Set Name="ExcelApi" MinVersion="1.4" />
    </Sets>
  </Requirements>

  <Hosts>
    <Host Name="Workbook" />
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="http://127.0.0.1:47834/excel/index.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
