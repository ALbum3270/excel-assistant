{
  "name": "excel-assistant",
  "version": "0.2.0",
  "description": "A local AI agent in the Excel side panel, composed from open-source parts: Claude Agent SDK harness, Office.js and COM Excel tools, finance skills, and pluggable model providers.",
  "private": true,
  "main": "app/main.mjs",
  "type": "module",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "predev": "node scripts/build-pane.mjs",
    "dev": "node daemon/index.mjs",
    "preapp": "node scripts/build-pane.mjs",
    "app": "electron .",
    "prestart": "node scripts/build-pane.mjs",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vendor:office-agents": "node scripts/vendor-office-agents.mjs",
    "vendor:pi-context": "node scripts/vendor-pi-context.mjs",
    "build:pane": "node scripts/build-pane.mjs",
    "vendor:ai-elements": "node scripts/vendor-ai-elements.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.274",
    "@microsoft/office-js": "^1.1.110",
    "@modelcontextprotocol/sdk": "1.29.0",
    "just-bash": "^3.4.2",
    "papaparse": "^5.7.0",
    "ws": "^8.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@streamdown/cjk": "^1.0.3",
    "@tailwindcss/cli": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^42.0.1",
    "esbuild": "^0.28.2",
    "i18next": "^26.4.2",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "nanoid": "^5.1.16",
    "prettier": "3.8.3",
    "radix-ui": "^1.6.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^17.0.15",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "typebox": "1.3.7",
    "use-stick-to-bottom": "^1.1.6"
  }
}
