{
  "name": "excel-assistant",
  "version": "0.2.0",
  "description": "A local AI agent in the Excel side panel, composed from open-source parts: Claude Agent SDK harness, Office.js and COM Excel tools, finance skills, and pluggable model providers.",
  "private": true,
  "main": "app/main.mjs",
  "type": "module",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "dev": "node daemon/index.mjs",
    "app": "electron .",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vendor:office-agents": "node scripts/vendor-office-agents.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.274",
    "@microsoft/office-js": "^1.1.110",
    "dompurify": "^3.4.15",
    "just-bash": "^3.4.2",
    "marked": "^18.0.13",
    "papaparse": "^5.7.0",
    "ws": "^8.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "electron": "^42.0.1",
    "esbuild": "^0.28.2",
    "prettier": "3.8.3"
  }
}
